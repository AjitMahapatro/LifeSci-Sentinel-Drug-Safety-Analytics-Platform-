# =========================================================================
# LifeSci Sentinel - Environment template
# Copy to `.env` and fill in values. NEVER commit a real `.env`.
# All values below are safe placeholders.
# =========================================================================

# --- PostgreSQL (used by the `db` service and for local backend runs) ---
POSTGRES_USER=lifesci
POSTGRES_PASSWORD=lifesci
POSTGRES_DB=lifesci

# --- Backend database connection (must match Postgres above in compose) ---
DB_HOST=db            # use `db` inside compose; set to localhost for local runs
DB_PORT=5432
DB_NAME=lifesci
DB_USER=lifesci
DB_PASSWORD=lifesci

# --- CORS: origins permitted to call the API directly. ---
# For the docker-compose nginx proxy the frontend is same-origin, so CORS is
# only relevant for direct API access or a split deployment. Include any
# deployed frontend domain, comma-separated. Keep localhost for local dev.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Example with a deployed domain:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Host port bindings (which ports the containers expose on the host) ---
API_PORT=8000
FRONTEND_PORT=8080
DB_PORT=5432

# --- API runtime settings ---
UVICORN_WORKERS=1
DB_WAIT_TIMEOUT=90
# Set to 1 to force a full gold-layer reload on the API restart.
FORCE_SEED=0

# --- Frontend build ---
# Leave empty to use the same-origin nginx proxy (recommended in compose).
# To point the frontend at a separately deployed API, set its public base
# URL here, e.g. https://your-api.example.com
VITE_API_URL=

# --- Optional LLM enhancement (leave empty to keep the offline rule-based
#     assistant; only set if you have a key) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

