# --- OpenFDA API (optional) ---
# The OpenFDA public API works WITHOUT a key for normal usage.
# The ingestion code (src/ingestion/openfda_ingest.py) reads FDA_API_KEY and
# passes it as the api_key parameter automatically.
# Set one here ONLY if you have a registered/premium OpenFDA key to raise rate limits.
# Leave blank for anonymous public access (default and fully functional).
FDA_API_KEY=

# LifeSci Sentinel - Example environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env` file.

# --- PostgreSQL (primary data source) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifesci
DB_USER=admin
DB_PASSWORD=change_me

# --- CORS (comma-separated origins allowed for the React frontend) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional LLM integration (AI assistant enhancement only) ---
# If OPENAI_API_KEY is left blank, the AI assistant runs fully offline
# using the grounded rule-based explanation engine (no network, no cost).
# The LLM is NEVER the source of truth for numbers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
